# Docker Compose. Set two distinct private passwords in your local .env.
CAMPUS_DB_USER=campus
CAMPUS_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
CAMPUS_MYSQL_PORT=3306
CAMPUS_APP_PORT=8080

# Optional Caddy HTTPS profile; hostname must resolve to the server.
CAMPUS_DOMAIN=

# Student email verification and account recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=

# Optional map integrations
GOOGLE_MAPS_API_KEY=
KAKAO_REST_API_KEY=
